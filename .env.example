# Copy to .env.local and fill in to switch the app from the local mock data
# provider to a real Supabase backend. See supabase/migrations/ for the
# schema that must be applied first, and src/services/index.ts for the
# provider switch.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: internally hosted OCR language data (traineddata) for fully
# offline/intranet operation. Leave unset to use tesseract.js's CDN default.
# See README "OCR offline betreiben".
VITE_TESSERACT_LANG_PATH=
